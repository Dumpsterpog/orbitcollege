# Copy to .env and fill in. Never commit the real .env (already gitignored).
#
# Orbit currently needs BOTH providers:
#   Firebase  — sign-in (Google) and the profiles collection
#   Supabase  — communities, posts, events, chat, Locali-Tea
# Dropping Supabase means migrating those tables to Firestore; until then,
# leaving either block blank disables that half of the app.


# ─────────────────────────────────────────────────────────────────────────
# FIREBASE — auth + profiles
# Console -> Project settings -> General -> Your apps -> Web app
#            -> SDK setup and configuration -> Config
#
# These are public identifiers, not secrets. Firebase web config ships to
# the browser by design; access is enforced by Firestore security rules,
# not by hiding the apiKey. Never put a service-account JSON here — any
# VITE_* value is compiled into the client bundle.
# ─────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Console steps that are NOT env vars but are required for sign-in to work:
#   1. Authentication -> Sign-in method -> enable Google
#   2. Authentication -> Settings -> Authorized domains -> add localhost
#      and your deploy domain (otherwise: auth/unauthorized-domain)
#   3. Firestore Database -> create, and allow signed-in users to read/write
#      their own doc under profiles/{uid}


# ─────────────────────────────────────────────────────────────────────────
# SUPABASE — all app data
# Dashboard -> your project -> Settings -> API
#   Project URL      -> VITE_SUPABASE_URL
#   anon public key  -> VITE_SUPABASE_ANON_KEY
#
# The anon key is safe to ship: it only works within the Row Level Security
# policies defined in supabase/schema*.sql.
# ─────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=


# Optional dev switch — skips auth and lands straight on the dashboard.
# VITE_SKIP_AUTH=true

# Reveals the Admin nav entry without a session, for development only.
# The panel's data is gated by RLS regardless of this flag.
# VITE_ADMIN_PREVIEW=true
