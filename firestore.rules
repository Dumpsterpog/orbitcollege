rules_version = '2';

// Orbit — Firestore security rules.
//
// Paste into Firebase Console -> Firestore Database -> Rules -> Publish.
//
// These replace every RLS policy from the Supabase schema files. The model is
// the same one the app always had:
//
//   Reading campus content is public. Communities, posts, events and
//   Locali-Tea are readable signed out, because a student deciding whether to
//   sign up should be able to see what is here first.
//
//   Writing needs an account. Every create/update/delete below requires a
//   signed-in caller, and almost all of them require that caller to be the
//   owner of the thing being changed.
//
//   Anonymity is structural. Firestore cannot hide one field of a readable
//   document, so Locali-Tea ownership is kept in a separate collection that
//   nobody can read at all. See the note above tea_authors.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()      { return request.auth != null; }
    function isSelf(uid)     { return signedIn() && request.auth.uid == uid; }
    function isAdmin()       {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isAdmin == true;
    }
    // Off-platform invite links, refused server-side.
    //
    // The client filter in lib/moderation.js does the rest and does it better:
    // it can normalise leetspeak, collapse spacing tricks and explain what was
    // wrong. None of that is expressible here -- rules get one regex and no
    // way to say why -- and anyone can bypass a client check by opening a
    // console.
    //
    // So this covers only the abuse that actually pays to automate: dropping
    // a Telegram or WhatsApp invite into a campus feed to move students to an
    // unmoderated channel, which is the first step of every scam and porn ring
    // that has ever targeted a student body. Word filtering stays in the
    // client, where a human-readable refusal is worth more than an
    // unbypassable one.
    function noInviteLinks(text) {
      // [.] rather than \. on purpose: a backslash inside a rules string needs
      // doubling to survive into the regex, and getting that wrong yields a
      // pattern that matches nothing while looking correct. A character class
      // sidesteps the escaping question entirely.
      //
      // (?s) matters as much as the pattern. Without it `.` stops at a line
      // break, matches() has to consume the whole string, and so any post
      // with a newline before the link sailed through: "hi\nt.me/x" passed.
      return !text.matches('(?is).*(t[.]me/|telegram[.](me|dog)/|chat[.]whatsapp[.]com/|discord[.]gg/|discord[.]com/invite/|onlyfans[.]com).*');
    }

    // Unambiguous pornography terms, refused on direct writes.
    //
    // The review queue is the real control: the client sends sexual, dating
    // and NSFW posts to moderation_queue instead of the feed. This is what
    // stops someone skipping the queue from a console. It is deliberately a
    // short list of words with no innocent reading -- anything broader belongs
    // in the queue, where a person decides -- and lib/moderation.js mirrors it
    // exactly (RULES_MIRROR), so an honest client queues everything this
    // would refuse and never meets it.
    function noExplicit(text) {
      return !text.matches('(?is)(.*[^a-z])?(porn|porno|pornhub|xvideos|xnxx|xhamster|nudes|sexting|hentai)([^a-z].*)?');
    }

    // Fields a user must never be able to set on themselves.
    function noPrivilegeEscalation() {
      // communitiesCreated joins isAdmin here: it is a quota, so letting
      // someone write their own would make the cap decorative. suspended is
      // the same: a suspension you can lift yourself is not one.
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isAdmin', 'communitiesCreated', 'suspended']);
    }

    // Suspended by an admin from the admin tool. Checked on every write that
    // puts words in front of other people -- posts, comments, chat, Tea,
    // communities, the review queue -- and on nothing else, so a suspended
    // student can still read, leave communities and file reports.
    function notSuspended() {
      return !exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('suspended', false) != true;
    }

    /* ------------------------------------------------------- profiles */

    match /profiles/{uid} {
      // Names are readable so posts can carry a byline. Email is in the same
      // document, which is a real limitation of document databases: Firestore
      // cannot grant per-field reads the way Postgres column grants could.
      // Accepted because the app only ever renders name, and the alternative
      // (a second public_profiles collection kept in sync) costs more than it
      // buys at this size. If email must be private, that split is the fix.
      allow read: if true;

      // noPrivilegeEscalation() only guards updates, which left create wide
      // open: a new account could write its own profile with isAdmin: true
      // on the very first write and be an admin. The same three fields are
      // pinned to their defaults here.
      allow create: if isSelf(uid)
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('suspended', false) == false
        && request.resource.data.get('communitiesCreated', 0) == 0;
      // isAdmin is deliberately excluded, so nobody can promote themselves.
      // Set it from the Firebase console or the admin tool.
      allow update: if (isSelf(uid) && noPrivilegeEscalation()) || isAdmin();
      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------- communities */

    match /communities/{communityId} {
      // How many this account has already created. Absent means zero, which is
      // what every existing profile reads as -- no migration needed.
      function ownedCommunities() {
        return exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
          ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('communitiesCreated', 0)
          : 0;
      }

      function isCreator() {
        return signedIn() && resource.data.creatorId == request.auth.uid;
      }
      function isMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
      }
      function isCommunityAdmin() {
        return signedIn()
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role == 'admin';
      }

      // Nothing that identifies the community changed in this write.
      //
      // This deliberately avoids diff().affectedKeys(). joinCommunity bumps
      // memberCount with increment() and lastActiveAt with serverTimestamp(),
      // which reach the server as updateTransforms with an EMPTY updateMask --
      // the fields are never named in the write itself. What affectedKeys()
      // reports for a transform-only update is not something to stake a join
      // on, and when it is wrong the failure is a flat permission-denied with
      // nothing to read.
      //
      // Comparing the identity fields directly has no such ambiguity: whatever
      // the transforms do to the counters, these six either match the stored
      // document or they do not. get(key, default) tolerates a field that has
      // never been set, which a comparison on a missing key would not.
      function identityUnchanged() {
        return request.resource.data.get('name', '')       == resource.data.get('name', '')
          && request.resource.data.get('handle', '')       == resource.data.get('handle', '')
          && request.resource.data.get('creatorId', '')    == resource.data.get('creatorId', '')
          && request.resource.data.get('category', '')     == resource.data.get('category', '')
          && request.resource.data.get('official', false)  == resource.data.get('official', false)
          && request.resource.data.get('postsAdminOnly', false)
             == resource.data.get('postsAdminOnly', false);
      }

      allow read: if true;

      // Two communities per account, enforced here and not only in the client.
      //
      // The count lives on the creator's profile because rules cannot query a
      // collection -- there is no way to ask "how many communities does this
      // person already own" at evaluation time. db.js bumps
      // profiles/{uid}.communitiesCreated in the same batch as the create, and
      // the profile rule below refuses any other write to that field, so it
      // cannot be edited down to buy more.
      //
      // The post limit has no equivalent and is client-side only: it needs a
      // count of recent documents, which is exactly the query rules cannot do.
      // Closing that properly means a Cloud Function or an App Check quota;
      // until then it slows honest users down and stops nobody determined.
      // The cap is a student limit. An admin creating an official space, such
      // as the chat community that comes with an event, is not spending their
      // own quota.
      allow create: if isAdmin()
        || (signedIn() && notSuspended()
            && request.resource.data.creatorId == request.auth.uid
            && ownedCommunities() < 2);

      // The last clause is what makes joining possible for anyone who is not
      // the creator.
      //
      // A join writes the member document and bumps memberCount. Rules
      // evaluate against committed state, so when the counter write is
      // checked the member document does not exist yet and isMember() is
      // false for the very person joining -- only isCreator() could ever pass,
      // which is why joining worked for whoever made the community and failed
      // silently for everyone else.
      //
      // Scoped by identityUnchanged(), so a stranger can move the counters but
      // cannot rename, recategorise, reassign or unpublish a community. They
      // can still write a wrong number into memberCount; moving counters to a
      // Cloud Function is the fix for that, and the upgrade path if it is ever
      // abused.
      allow update: if isCreator() || isCommunityAdmin() || isAdmin()
        || (signedIn() && identityUnchanged());

      allow delete: if isCreator() || isAdmin();

      match /members/{memberId} {
        allow read: if true;
        // You add and remove yourself. Nobody adds you to anything.
        allow create: if isSelf(memberId);
        allow delete: if isSelf(memberId) || isCreator() || isAdmin();
        // Only the community's creator promotes or demotes.
        allow update: if isCreator() || isAdmin();
      }

      match /posts/{postId} {
        allow read: if true;
        // Second clause: an admin approving a queued post writes it under
        // the original author's id, and the author need not be a member any
        // more. noExplicit is waived for exactly that case -- the queue exists
        // so a person can approve what the word list would refuse.
        allow create: if (signedIn() && notSuspended()
            && request.resource.data.authorId == request.auth.uid
            && isMember()
            && noInviteLinks(request.resource.data.get('text', ''))
            && noExplicit(request.resource.data.get('text', '')))
          || (isAdmin() && noInviteLinks(request.resource.data.get('text', '')));
        // sparkCount and pinned are the only reasons a non-author updates.
        allow update: if signedIn();
        allow delete: if (signedIn() && resource.data.authorId == request.auth.uid)
          || isCreator() || isCommunityAdmin() || isAdmin();

        match /sparks/{sparkUid} {
          allow read: if true;
          allow create, delete: if isSelf(sparkUid);
        }

        // Comments. Readable by anyone who can read the post, which is
        // everyone; writable by anyone signed in. Removal is the author, the
        // community's leadership, or an app admin.
        match /comments/{commentId} {
          allow read: if true;
          allow create: if signedIn() && notSuspended()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && noInviteLinks(request.resource.data.text)
            && noExplicit(request.resource.data.text);
          allow delete: if (signedIn() && resource.data.authorId == request.auth.uid)
            || isCreator() || isCommunityAdmin() || isAdmin();
        }
      }

      match /messages/{messageId} {
        // Chat is members-only. A post is broadcast; a message is not.
        allow read: if isMember() || isAdmin();
        allow create: if signedIn() && notSuspended()
          && request.resource.data.authorId == request.auth.uid
          && isMember();
        allow update: if isMember();
        allow delete: if (signedIn() && resource.data.authorId == request.auth.uid)
          || isCreator() || isCommunityAdmin() || isAdmin();
      }
    }

    /* --------------------------------------------------- campus posts */

    // Posts that belong to no community.
    //
    // Posting used to require joining something first, which put a chore in
    // front of the one action the app wants from a new account. A campus post
    // needs only an account: it is addressed to everyone, and it lives here
    // rather than in a community subcollection.
    //
    // The home feed does not need changing for this. collectionGroup("posts")
    // matches a collection of that name at any depth, so a root `posts`
    // collection is swept up by the query that already runs.
    match /posts/{postId} {
      allow read: if true;

      // No condition on communityId, deliberately.
      //
      // Two earlier versions of this rule policed that field -- first
      // `== null`, then `!('communityId' in ...)` -- to stop a root post
      // claiming to belong to a community. Both worked only against one exact
      // client write, so publishing rules against an older deployed bundle
      // refused every post, with a flat permission-denied naming nothing.
      //
      // The check is gone because the problem is gone: mapPost now takes a
      // post's community from its document path instead of this field. A path
      // cannot lie about where a document lives. The field is no longer read
      // by the app at all, so there is nothing left to forge.
      // Second clause: an admin publishing an approved queue item, under the
      // original author's id. See moderation_queue below.
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && noInviteLinks(request.resource.data.text)
        && ((signedIn() && notSuspended()
              && request.resource.data.authorId == request.auth.uid
              && noExplicit(request.resource.data.text))
            || isAdmin());

      // Sparks only. Nobody edits someone else's post text.
      //
      // Same reasoning as the community counters: sparkCount moves by
      // increment(), which arrives as a transform with an empty updateMask, so
      // this asserts the fields that must NOT change instead of diffing the
      // ones that may.
      // Counters only: sparkCount and commentCount move, the post itself does
      // not. Stated as what must hold rather than what may change, for the
      // same reason as everywhere else in this file -- both counters arrive as
      // increment() transforms, which a diff cannot see reliably.
      allow update: if signedIn()
        && request.resource.data.text == resource.data.text
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.get('imageUrl', '') == resource.data.get('imageUrl', '');

      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid)
        || isAdmin();

      match /sparks/{sparkUid} {
        allow read: if true;
        allow create, delete: if isSelf(sparkUid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && notSuspended()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && noInviteLinks(request.resource.data.text)
          && noExplicit(request.resource.data.text);
        allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
      }
    }

    /* --------------------------------------------------------- events */

    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // linkedCommunityId is stamped by the first registration, which is why
      // a signed-in caller can update.
      allow update: if signedIn();

      match /registrations/{regUid} {
        allow read: if true;
        allow create, delete: if isSelf(regUid);
      }

      // Registration details: name, college, year, referral.
      //
      // Separate from registrations above because that one is public -- it
      // carries the going count and is swept up by a collection-group read
      // rule. Personal details are readable only by the student who entered
      // them and by an admin.
      //
      // The student can write their own entry and say they have paid. They
      // cannot mark it verified, issue themselves a pass, or edit anything
      // once an admin has verified it: money and entry are admin-only facts.
      match /signups/{signupUid} {
        allow read: if isSelf(signupUid) || isAdmin();

        allow create: if isSelf(signupUid) && notSuspended()
          && request.resource.data.status == 'pending_payment'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120;

        allow update: if isAdmin()
          || (isSelf(signupUid)
              && resource.data.status != 'verified'
              && (request.resource.data.status == 'pending_payment'
                  || request.resource.data.status == 'payment_claimed')
              && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['passCode', 'checkedInAt', 'checkedInBy', 'verifiedAt', 'verifiedBy', 'amount']));

        allow delete: if isAdmin();
      }
    }

    /* ----------------------------------------------------- Locali-Tea */

    // Anonymity here is structural, not a matter of the client not asking.
    //
    // Firestore has no per-field read permission: if a document is readable,
    // every field in it is readable. So an authorId stored on the tea post
    // itself would be legible to anyone who opened the network tab, no matter
    // what the app requests. Postgres could hide a column; this cannot.
    //
    // Ownership therefore lives in a separate tea_authors/{teaId} document
    // that NOBODY can read — not the author, not an admin, not the client at
    // all. Rules can still consult it, because get() inside a rule runs
    // server-side and is not bound by the read permission it is evaluating.
    // That is what lets "only the author may delete this" hold without the
    // author ever being knowable.
    match /tea_authors/{teaId} {
      allow read: if false;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /tea_posts/{teaId} {
      function isTeaAuthor() {
        return signedIn()
          && exists(/databases/$(database)/documents/tea_authors/$(teaId))
          && get(/databases/$(database)/documents/tea_authors/$(teaId)).data.authorId == request.auth.uid;
      }

      allow read: if true;

      // No authorId on the document itself. A create that tries to add one is
      // refused, so the anonymity cannot be undone by a future client bug.
      allow create: if signedIn() && notSuspended()
        && !('authorId' in request.resource.data.keys())
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && noInviteLinks(request.resource.data.text)
        && noExplicit(request.resource.data.text);

      // Vote and reaction counters.
      allow update: if signedIn() && !('authorId' in request.resource.data.keys());
      allow delete: if isTeaAuthor() || isAdmin();

      match /comments/{commentId} {
        function isCommentAuthor() {
          return signedIn()
            && exists(/databases/$(database)/documents/tea_authors/$(commentId))
            && get(/databases/$(database)/documents/tea_authors/$(commentId)).data.authorId == request.auth.uid;
        }
        allow read: if true;
        allow create: if signedIn() && notSuspended() && !('authorId' in request.resource.data.keys());
        allow delete: if isCommentAuthor() || isAdmin();
      }
      match /votes/{voteUid}     { allow read, create, update, delete: if isSelf(voteUid); }
      match /reactions/{reactUid} { allow read, create, update, delete: if isSelf(reactUid); }
    }

    /* -------------------------------------------------- review queue */

    // Posts held for a moderator: sexual, dating, NSFW links.
    //
    // A separate collection rather than a `status` field on posts, because
    // posts are world-readable and Firestore cannot hide a document from a
    // query by a field -- a pending post in `posts` would be one network tab
    // away from public. Here only two people can ever read an entry: the
    // author, so they can see it is waiting, and an admin.
    //
    // Approval is an admin writing the real post (the isAdmin() clauses on
    // both post rules) and marking the entry approved. Rejected entries are
    // kept, not deleted, so the admin tool can show who keeps trying.
    match /moderation_queue/{itemId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn() && notSuspended()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    /* -------------------------------------------------- announcements */

    // Banners the admin tool puts at the top of everyone's home feed. Public
    // to read, because a notice about a campus closure is for guests too;
    // admin-only to write.
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* -------------------------------------------------- admin presence */

    // When each admin last had the admin tool open. Written by the tool once a
    // minute for the signed-in admin's own entry only; readable by admins.
    match /admin_presence/{uid} {
      allow read: if isAdmin();
      allow create, update: if isSelf(uid) && isAdmin();
      allow delete: if isAdmin();
    }

    /* ------------------------------------------------------------ ads */

    // Promoted cards in the feed and rail. Created, edited and removed only
    // from the admin tool.
    //
    // Readable only while live: drafts and paused ads are nobody's business
    // but an admin's, and watchAds filters on status == 'live', which is what
    // makes that query allowed.
    //
    // The one write anyone can make is the counters, and only by one at a
    // time, and only on a live ad. That keeps impressions and clicks honest
    // against a careless client; it does not stop someone scripting a
    // thousand +1s. Real ad fraud protection needs a server, and the admin
    // tool labels these numbers as approximate for that reason.
    match /ads/{adId} {
      allow read: if resource.data.status == 'live' || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.status == 'live'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks'])
            && request.resource.data.get('impressions', 0) >= resource.data.get('impressions', 0)
            && request.resource.data.get('impressions', 0) <= resource.data.get('impressions', 0) + 1
            && request.resource.data.get('clicks', 0) >= resource.data.get('clicks', 0)
            && request.resource.data.get('clicks', 0) <= resource.data.get('clicks', 0) + 1);
    }

    /* ------------------------------------------------ stickers, reports */

    match /stickers/{stickerId} {
      allow read: if true;
      allow create: if signedIn() && notSuspended() && request.resource.data.authorId == request.auth.uid;
      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /reports/{reportId} {
      // Write-only for users: you can file one, you cannot read the queue.
      // Reading everyone's reports is a moderator capability.
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /* ------------------------------------------ collection-group queries */

    // These six blocks are not duplicates of the nested rules above. They are
    // the only thing that authorises a collectionGroup() query, and without
    // them every cross-community read in db.js fails.
    //
    // A nested `match /communities/{id}/posts/{postId}` authorises reading
    // posts *of one known community*. It does NOT authorise
    // `collectionGroup(db, "posts")`, which reads across every community at
    // once and is matched only by the `/{path=**}/posts/{postId}` form. Miss
    // this and the failure is maximally confusing: permission-denied on a
    // collection whose nested rule plainly says the read is allowed, and a UI
    // that renders as an empty database rather than as an error.
    //
    // Each one mirrors the permission of its nested twin, so nothing is
    // widened here. Where the nested rule is owner-only, the group rule
    // requires the query to filter on uid -- Firestore only permits a query
    // it can prove matches solely documents the rule allows, so the
    // constraint in db.js and the condition here have to agree.

    // Public campus content: the home feed, member lists, spark and
    // registration counts. All `if true` above, all `if true` here.
    match /{path=**}/posts/{postId}   { allow read: if true; }
    match /{path=**}/members/{uid}    { allow read: if true; }
    match /{path=**}/sparks/{uid}     { allow read: if true; }
    match /{path=**}/registrations/{uid} { allow read: if true; }

    // Private: your own Locali-Tea votes and reactions, and nobody else's.
    // fetchMyTeaVotes/fetchMyTeaReactions filter on uid, which is what makes
    // this satisfiable.
    match /{path=**}/votes/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/reactions/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Chat across every community at once, for the admin tool's moderation
    // view. Without this, even an admin's collectionGroup("messages") query is
    // denied, because the nested messages rule only covers one community at a
    // time. Admin-only, mirroring the nested rule's isAdmin() branch -- nothing
    // is widened for ordinary members.
    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
    }

    // Anything not named above is denied. New collections have to be added
    // here deliberately rather than inheriting a permissive default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
